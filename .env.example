# ─────────────────────────────────────────────────────────────
# SWARA Environment Variables — Example File
# Copy this to backend/.env for local development.
# Set these in the Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────
# NEVER commit real values to version control.
# ─────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────
# LOCAL:      Leave empty → SQLite (swara.db) is used automatically
# PRODUCTION: PostgreSQL connection string from Neon, Supabase, Railway, etc.
DATABASE_URL=your_database_url_here

# ── AUTHENTICATION ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_strong_secret_here

# ── AI / GEMINI ──────────────────────────────────────────────
# LLM_PROVIDER: GEMINI (production) or MOCK (local testing without API key)
LLM_PROVIDER=GEMINI
# YOUR GEMINI API KEY — SECRET — BACKEND ONLY
# Never use a VITE_ prefix — never expose to the browser.
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-flash-lite-latest

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# LOCAL:      Leave as * or set http://localhost:5173
# PRODUCTION: Set to your Vercel frontend URL
CORS_ORIGINS=https://your-swara-app.vercel.app

# ── ENVIRONMENT ──────────────────────────────────────────────
ENVIRONMENT=production

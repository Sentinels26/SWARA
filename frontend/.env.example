# SWARA Frontend Environment Variables — Example File
# Copy this to frontend/.env for local development.

# ── API CONNECTION ───────────────────────────────────────────
# LOCAL:      Leave empty or set to http://localhost:8001
# PRODUCTION: Set to your Vercel frontend URL or backend URL
VITE_API_BASE_URL=https://your-swara-app.vercel.app

# WARNING: NEVER PUT REAL SECRETS (like Gemini API keys or JWT secrets) IN THIS FILE.
# ANY VARIABLE STARTING WITH VITE_ IS EXPOSED TO THE BROWSER.

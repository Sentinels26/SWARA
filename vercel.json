{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/cases/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/checkins/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/consents/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/baselines/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/safety-plan/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/analysis/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/journey/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/actions/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/alerts/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/chat/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/appointments/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|cases|checkins|consents|baselines|safety-plan|analysis|journey|actions|alerts|chat|appointments|health).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "env": {
    "PYTHONPATH": "backend"
  }
}
